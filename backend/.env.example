# 後端環境變數範本
# 複製成 .env 後填入實際值：  cp .env.example .env
# ⚠️ .env 內含金鑰，已被 .gitignore 擋住，絕不可 commit

# PostgreSQL 連線字串（需含 pgvector 擴充）
# 格式：postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Gemini API 金鑰（後端啟動時會實際打一次 API 驗證）
GEMINI_API_KEY=

# 問診用的 Gemini 模型名稱；未設定時預設 gemini-3.1-flash-lite
GEMINI_MODEL_NAME=gemini-3.1-flash-lite

# JWT 簽章密鑰（必填，未設定後端會直接啟動失敗）
# 產生方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=

# JWT 有效時間（分鐘）；未設定時預設 1440（一天）
AUTH_TOKEN_EXPIRE_MINUTES=1440

# 允許的 CORS 來源，逗號分隔（例：https://carepath.example,https://www.carepath.example）
# 未設定時只放行本機開發用的 http://localhost:5174 與 http://127.0.0.1:5174。
# ⚠️ 不要設成 *：wildcard 與 credentials 不能並存，設了會自動關掉 allow_credentials。
#    原生 App 不受影響 —— CORS 是瀏覽器強制的，APK 的請求不帶 Origin。
CORS_ALLOWED_ORIGINS=

# 訪客登入（/api/v1/auth/guest-login）的速率限制，皆為選填。
# 預設每個來源每小時 20 次。決賽現場評審可能共用同一個出口 IP，不夠時調大。
GUEST_LOGIN_RATE_LIMIT=20
GUEST_LOGIN_RATE_WINDOW_SECONDS=3600
