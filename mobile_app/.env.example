# 行動端環境變數範本
# 複製成 .env 後填入實際值：  cp .env.example .env
# ⚠️ EXPO_PUBLIC_ 開頭的變數會在打包時內嵌進 bundle，只能放可公開的值；
#    改了要重新打包才會生效，不是重開 app 就好。

# 後端 API 位址；未設定時 src/api/client.js 會用內建預設值（ngrok 固定網域）
EXPO_PUBLIC_API_BASE_URL=

# Google Maps SDK for Android 金鑰
# 與網頁端那把不同：網頁走 referrer 限制，Android 走「套件名 + 憑證 SHA-1」限制，不能共用。
# 沒填的話 APK 裝得起來、問診正常，只有附近醫院地圖會是一片灰底。
GOOGLE_MAPS_ANDROID_API_KEY=
