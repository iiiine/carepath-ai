# 前端環境變數範本
# 複製成 .env.local 後填入實際值：  cp .env.example .env.local
# ⚠️ VITE_ 開頭的變數會被打包進前端 bundle，只能放可公開的金鑰
#    （Google Maps 金鑰請在 Google Cloud Console 設 referrer 限制）

# Google Maps JavaScript API 金鑰
# referrer 限制目前只放行 http://localhost:5174，故 Vite port 鎖死 5174
VITE_GOOGLE_MAPS_API_KEY=

# 後端 API 位址；未設定時 src/api/axios.js 會用內建預設值
VITE_API_BASE_URL=http://localhost:8000
